# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# Anthropic credentials. The SDK also accepts an `ant auth login` profile, in
# which case you can leave this unset entirely.
ANTHROPIC_API_KEY=

# --- Model -----------------------------------------------------------------
RA_MODEL=claude-opus-5
RA_EFFORT=high                 # low | medium | high | xhigh | max
RA_MAX_TOKENS=16000

# --- Grounding thresholds --------------------------------------------------
# Raise these to make the assistant more reluctant to answer.
RA_MIN_SUPPORTED_RATIO=0.8     # fraction of claims that must be evidence-backed
RA_MIN_EVIDENCE_SCORE=0.30     # absolute relevance needed before answering at all
RA_MIN_EVIDENCE_CHUNKS=1

# --- Chunking --------------------------------------------------------------
RA_CHUNK_SIZE=400              # tokens
RA_CHUNK_OVERLAP=60

# --- Retrieval -------------------------------------------------------------
RA_CANDIDATES=40               # retrieved before reranking
RA_TOP_K=8                     # passed to the model
RA_MAX_PER_DOC=3               # stops one document filling the context
RA_MIN_RELEVANCE=0.25
RA_RRF_K=60

# --- Storage ---------------------------------------------------------------
RA_STORE=memory                # memory | pgvector
DATABASE_URL=postgresql://research:research@localhost:5432/research
RA_EMBEDDER=local              # local | hash  (hash = offline, no model download)
RA_EMBEDDING_MODEL=all-MiniLM-L6-v2
RA_EMBEDDING_DIMS=384

# --- Web research (off by default) -----------------------------------------
RA_WEB_RESEARCH=false
RA_WEB_MAX_USES=5

# --- Trusted sources -------------------------------------------------------
# JSON file with {"tier_1": [...], "tier_2": [...], "replace": false}
RA_TRUSTED_DOMAINS_FILE=
RA_TIER1_DOMAINS=              # comma-separated additions
RA_TIER2_DOMAINS=

# --- Safety ----------------------------------------------------------------
RA_MAX_QUESTION_CHARS=2000
RA_RATE_LIMIT=20               # requests per minute per client
